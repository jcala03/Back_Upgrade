APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Local/testing only. Production is hard-blocked by the seeders.
SEED_DEMO_USERS=false
DEMO_ADMIN_NAME="Local administrator"
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_NAME="Local operator"
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Commercial PDFs: safe simulation by default. Local/testing NEVER use real SMTP.
COMMERCIAL_DOCUMENTS_REAL_MAIL_ENABLED=false
COMMERCIAL_DOCUMENTS_MAILER=smtp
COMMERCIAL_DOCUMENTS_FROM_ADDRESS=ventas@upgradecolombia.com
COMMERCIAL_DOCUMENTS_FROM_NAME="Upgrade La 79"
# Production preparation ONLY, after approval and mailbox/DNS verification:
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=ventas@upgradecolombia.com
# MAIL_PASSWORD=configure-only-in-private-production-environment
# Do not enable real mail or add credentials to this example.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BUSINESS_NAME="UP GRADE 79"
BUSINESS_WHATSAPP=573236293543
ORDER_NOTIFICATION_EMAIL=

WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=
WOMPI_RESERVATION_MINUTES=30

ENVIA_BASE_URL=https://api-test.envia.com
ENVIA_QUERIES_BASE_URL=https://queries.test.envia.com
ENVIA_API_TOKEN=
ENVIA_TIMEOUT=15
ENVIA_CONNECT_TIMEOUT=5
ENVIA_RETRIES=2

DHL_MYDHL_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_MYDHL_USERNAME=
DHL_MYDHL_PASSWORD=
DHL_MYDHL_ACCOUNT_NUMBER=
DHL_MYDHL_TIMEOUT=15
DHL_MYDHL_CONNECT_TIMEOUT=5
DHL_MYDHL_RETRIES=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional CRM Web Push. Never expose the private key through VITE_* variables.
WEBPUSH_ENABLED=false
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# HTTPS URL or mailto: contact; https://upgradecolombia.com is accepted.
WEBPUSH_VAPID_SUBJECT=
# Independent of QUEUE_CONNECTION. Keep Push out of synchronous business requests.
# Worker: php artisan queue:work database --queue=web-push --tries=3 --timeout=45
# DB_QUEUE_RETRY_AFTER (default 90) must exceed both job (30s) and worker (45s) timeouts.
WEBPUSH_QUEUE_CONNECTION=database
WEBPUSH_QUEUE=web-push
